# ──────────────────────────────────────────────
# ОценитьКвартиру — Environment Variables
# Copy this file to .env and fill in values.
# ──────────────────────────────────────────────

# ── Database ──────────────────────────────────
POSTGRES_USER=app
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=realestate
# Full DATABASE_URL is built from above in docker-compose.yml
# For direct use outside docker: postgresql+psycopg2://app:devpassword@localhost:5432/realestate

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Geocoding ─────────────────────────────────
# Options: mock (no network, dev only) | nominatim (free, no key) | yandex (requires key)
GEOCODING_PROVIDER=nominatim

# Required only when GEOCODING_PROVIDER=yandex
YANDEX_GEOCODING_API_KEY=

# ── Application ───────────────────────────────
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5000,http://localhost:3000

# ── Frontend ──────────────────────────────────
# URL of the FastAPI backend, visible to the browser
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Valuation Engine ──────────────────────────
# IQR multiplier for outlier filtering on price_per_sqm (default: 1.5)
IQR_MULTIPLIER=1.5

# ── Background Jobs ───────────────────────────
# How often Celery Beat refreshes listings for recent searches (hours)
PIPELINE_REFRESH_INTERVAL_HOURS=4
