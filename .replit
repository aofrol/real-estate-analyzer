modules = ["python-base-3.13", "nodejs-24"]
[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "docker compose up -d db redis backend worker --build && cd frontend && ([ -d node_modules ] || npm install) && npm run dev"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80
